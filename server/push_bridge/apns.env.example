# jarvis-ios-bridge APNs configuration — EnvironmentFile TEMPLATE (no secrets).
# Live copy: /opt/jarvis-ios-bridge/apns.env (root 600). Nothing in this file
# is secret material (kid/team/bundle/host flag only); the .p8 itself never
# lives in git. scripts/swap_apns_key.py rewrites APNS_KEY_ID here and in the
# live env together, so the repo and prod can't silently disagree on which kid
# is installed.
# NOTE: kid 2PMV4SF2LS is known ASC-only (APNs answers 403 InvalidProviderToken,
# found 2026-09-18 22:20) until Enrique's APNs-capable replacement key is
# installed via scripts/swap_apns_key.py.
APNS_KEY_ID=2PMV4SF2LS
APNS_TEAM_ID=5ZXB95KW57
APNS_P8_PATH=/opt/jarvis-ios-bridge/apns.key
APNS_BUNDLE_ID=com.enriquecodes.jarvis
APNS_SANDBOX=0
