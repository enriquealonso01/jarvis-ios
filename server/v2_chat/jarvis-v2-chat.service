[Unit]
Description=JARVIS iOS v2 chat adapter (/v1/conversations -> hermes chat)
After=network.target hermes-dashboard.service

[Service]
Type=simple
WorkingDirectory=/opt/jarvis-v2-chat
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/jarvis-ios-bridge/venv/bin/uvicorn main:app --host 127.0.0.1 --port 9170
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
