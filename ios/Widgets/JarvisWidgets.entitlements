<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups: the ONLY extra capability on the widget target. Shared
	     container carries the CC snapshot + bearer/refresh tokens the app
	     publishes (WidgetBridge.swift). The group must be registered on BOTH
	     App IDs (com.enriquecodes.jarvis and com.enriquecodes.jarvis.Widgets)
	     in the developer portal before profiles that include it can be
	     created — done via ASC API (docs/WIDGETS.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.enriquecodes.jarvis</string>
	</array>
</dict>
</plist>
