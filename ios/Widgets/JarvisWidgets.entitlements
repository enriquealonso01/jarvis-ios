<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Shared keychain with the app target (team-prefixed group; same team,
	    no portal registration — see JarvisApp.entitlements). Single group =
	    default access group for every SecItem call in this target.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.enriquecodes.jarvis.widgetshared</string>
	</array>
</dict>
</plist>
