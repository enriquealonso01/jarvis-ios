<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications: APNs device registration for the bridge. -->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	    Shared keychain (NOT an app group): the APP_GROUPS portal attach is a
	    web-UI-only step (no ASC API support, verified 2026-09-21), so widget
	    data flows through a team-prefixed keychain access group instead —
	    same team on both targets, no portal registration needed. Single
	    group = default access group for every SecItem call in both targets;
	    no kSecAttrAccessGroup needed in code.
	    NOTE: changing the app's default access group invalidates tokens
	    stored by pre-3.1 builds — one re-login after updating.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.enriquecodes.jarvis.widgetshared</string>
	</array>
</dict>
</plist>
