default_platform(:ios)

APP_ID    = "com.enriquecodes.jarvis"
WIDGET_APP_ID = "com.enriquecodes.jarvis.Widgets"
APP_GROUP = "group.com.enriquecodes.jarvis"
SCHEME    = "JarvisApp"
IOS_DIR   = File.expand_path("..", __dir__) # ios/
XCODEPROJ = File.join(IOS_DIR, "JarvisApp.xcodeproj")

# App Store Connect API key, assembled from CI env (same key also drives the
# push bridge's APNs — one .p8, both capabilities).
def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV.fetch("ASC_KEY_ID"),
    issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
    key_content:           ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: true
  )
end

# produce (portal side) authenticates via an api-key JSON file, not the
# lane-level key object — assemble one from the same CI secrets.
def asc_api_key_json_file
  require "base64"
  require "json"
  path = "/tmp/asc_api_key.json"
  File.write(path, JSON.generate({
    key_id:    ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key:       Base64.decode64(ENV.fetch("ASC_KEY_P8")).strip,
    in_house:  false
  }))
  File.chmod(0600, path)
  path
end

platform :ios do
  before_all do
    # Throwaway keychain on CI so match can install certs.
    setup_ci
  end

  desc "ONE-TIME: create the App Store distribution cert + provisioning profile and store them (encrypted) in the match repo. Run this once before the first beta."
  lane :bootstrap_signing do
    Dir.chdir(IOS_DIR) { sh("xcodegen") }
    match(
      type:           "appstore",
      app_identifier: APP_ID,
      api_key:        asc_api_key,
      readonly:       false
    )
  end

  # Widget extension data path: SHARED KEYCHAIN (keychain-access-groups on
  # both targets), not an app group. The APP_GROUPS portal attach between a
  # group and a bundle ID is a web-UI-only operation — the ASC v1 API has no
  # appGroups resource (404, verified 2026-09-21) — and produce's portal
  # login is Apple-ID-only (Spaceship.login(username), run 35614797372),
  # incompatible with this API-key runner. Keychain needs no portal state:
  # same team prefix on both targets. The APP_GROUPS *capability* was still
  # enabled on both bundle IDs via the ASC API on 2026-09-21 (harmless if
  # unused; a future app-group migration only needs the UI attach).
  private_lane :ensure_widget_portal do
    UI.message("Widget data path: shared keychain access group (no app group, no portal setup needed).")
  end

  # Pulls signing material and produces a signed, App Store-ready .ipa.
  private_lane :archive do
    ensure_widget_portal

    # force + readonly:false: the group entitlement was just attached, and
    # cached profiles in the match repo predate it — profiles must be
    # RE-created or codesign rejects the app-group entitlement at archive.
    # (App Store profiles have no device cost; renewing each build is free.)
    match(
      type:              "appstore",
      app_identifier:    APP_ID,
      api_key:           asc_api_key,
      readonly:          false,
      force:             true,
      keychain_password: ""
    )

    # Widget profile must exist too — same team, force re-create so the
    # keychain-access-groups entitlement is present in the profile.
    match(
      type:              "appstore",
      app_identifier:    WIDGET_APP_ID,
      api_key:           asc_api_key,
      readonly:          false,
      force:             true,
      keychain_password: ""
    )

    # Force manual signing for this archive only. Edits happen on the ephemeral
    # runner's checkout; the committed project stays Automatic for local Xcode use.
    # SCOPED per target: an unscoped call overwrites the previous target's
    # mapping (the run-3 push-entitlement failure), so app and widget each get
    # their own profile mapping.
    update_code_signing_settings(
      path:                  XCODEPROJ,
      use_automatic_signing: false,
      team_id:               ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier:     APP_ID,
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{APP_ID}"
    )
    update_code_signing_settings(
      path:                  XCODEPROJ,
      use_automatic_signing: false,
      team_id:               ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier:     WIDGET_APP_ID,
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{WIDGET_APP_ID}"
    )

    # TestFlight requires a unique build number per upload. Stamp it at archive
    # time via xcargs (project.yml's base value is just a local fallback; CI
    # always overrides) — bumping the pbxproj would drift on the next xcodegen run.
    #
    # XCODE 26 TRAP (runs 35420950536 → 35424281811, 2026-09-19): xcodebuild's
    # ARCHIVE now performs automatic app-version management by DEFAULT — it
    # resets CFBundleVersion to 1 in the archived app, ignoring
    # CURRENT_PROJECT_VERSION — and gym appends xcargs to the -exportArchive
    # command too, where build settings switch export into the same mode (the
    # ipa comes out CFBundleVersion=1 and ASC rejects with -19232 "bundle
    # version must be higher"). Countermeasures, both required:
    #   1. ARCHIVE carries MANAGE_APP_VERSION_AND_BUILD_NUMBER=NO so the
    #      CURRENT_PROJECT_VERSION stamp lands in the archive untouched.
    #   2. EXPORT is done by hand with a plist we control and ZERO build
    #      settings on the command line, so xcodebuild copies the archive's
    #      Info.plist as-is.
    # Guards below verify the stamp in the ARCHIVE and again in the .IPA.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    build_dir    = File.join(IOS_DIR, "build")
    archive_path = File.join(build_dir, "JarvisApp.xcarchive")
    export_path  = File.join(build_dir, "export")
    FileUtils.rm_rf(archive_path)
    FileUtils.rm_rf(export_path)
    FileUtils.mkdir_p(build_dir)

    # STEP 1 — archive ONLY (skip_package_ipa), version management disabled.
    build_app(
      project:          XCODEPROJ,
      scheme:           SCHEME,
      archive_path:     archive_path,
      skip_package_ipa: true,
      xcargs:           "CURRENT_PROJECT_VERSION=#{build_number} MANAGE_APP_VERSION_AND_BUILD_NUMBER=NO DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )

    # Guard: the stamp must be IN the archive before exporting.
    archived = sh(
      "set -e; plutil -extract CFBundleVersion raw -o - " \
      "#{File.join(archive_path, 'Products', 'Applications', "#{SCHEME}.app", 'Info.plist').shellescape}"
    ).strip
    UI.user_error!(
      "archive has CFBundleVersion=#{archived}, expected #{build_number} — " \
      "the xcargs stamp failed; do not upload"
    ) unless archived == build_number.to_s

    # STEP 2 — export with an explicit plist, no build settings on the CLI.
    export_plist = File.join(build_dir, "ExportOptions.plist")
    File.write(export_plist, {
      "method"                          => "app-store",
      "signingStyle"                    => "manual",
      "teamID"                          => ENV.fetch("APPLE_TEAM_ID"),
      "provisioningProfiles"            => { APP_ID => "match AppStore #{APP_ID}" },
      # Explicit false: absence is not safe on Xcode 26 (default flipped).
      "manageAppVersionAndBuildNumber"  => false
    }.to_plist)
    sh("xcodebuild -exportArchive -archivePath #{archive_path.shellescape} " \
       "-exportPath #{export_path.shellescape} " \
       "-exportOptionsPlist #{export_plist.shellescape}")

    ipa = Dir[File.join(export_path, "*.ipa")].first
    UI.user_error!("export produced no .ipa — cannot continue") unless ipa
    Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] = ipa

    # STEP 3 — verify the stamp SURVIVED export; fail loudly instead of letting
    # ASC reject a duplicate build number minutes later.
    stamped = sh(
      "set -e; rm -f /tmp/jarvis_info.plist; " \
      "unzip -p #{ipa.shellescape} Payload/#{SCHEME}.app/Info.plist > /tmp/jarvis_info.plist; " \
      "plutil -extract CFBundleVersion raw -o - /tmp/jarvis_info.plist"
    ).strip
    UI.user_error!(
      "export renumbered the build: ipa has CFBundleVersion=#{stamped}, " \
      "expected #{build_number} — check ExportOptions.plist and the -exportArchive args"
    ) unless stamped == build_number.to_s
    UI.success("build number verified in .ipa: CFBundleVersion=#{stamped}")
  end

  desc "Build and ship to TestFlight (installs on your iPhone via the TestFlight app — no Mac needed)"
  lane :beta do
    Dir.chdir(IOS_DIR) { sh("xcodegen") }
    # Diagnostic: print the GENERATED Info.plist so a literal-vs-reference
    # version bug is visible in the CI log instead of guessed at.
    generated = File.join(IOS_DIR, "JarvisApp", "Info.plist")
    UI.message("generated Info.plist → " + sh("plutil -p #{generated.shellescape}").gsub(/\s+/, " "))
    archive
    upload_to_testflight(
      api_key:                           asc_api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
